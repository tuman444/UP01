<Window x:Class="UP01.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UP01"
        mc:Ignorable="d"
        Title="MainWindow" Height="500" Width="900">
    <Grid Background="#1E1E2E">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="66"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        
        <Border Grid.Column="0" Background="#181825">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                <Button Width="52" Height="52" Margin="0,3"
                        FontSize="22" Foreground="#CDD6F4"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Click="BtnCatalog_Click"
                        ToolTipService.InitialShowDelay="600">
                    <Button.ToolTip>
                        <ToolTip Content="Каталог книг"/>
                    </Button.ToolTip>
                    <TextBlock Text="📚"/>
                </Button>

                <Button Width="52" Height="52" Margin="0,3"
                        FontSize="22" Foreground="#CDD6F4"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Click="BtnLists_Click"
                        ToolTipService.InitialShowDelay="600">
                    <Button.ToolTip>
                        <ToolTip Content="Списки книг"/>
                    </Button.ToolTip>
                    <TextBlock Text="🔖"/>
                </Button>

                <Button Width="52" Height="52" Margin="0,3"
                        FontSize="22" Foreground="#CDD6F4"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Click="BtnProfile_Click"
                        ToolTipService.InitialShowDelay="600">
                    <Button.ToolTip>
                        <ToolTip Content="Профиль"/>
                    </Button.ToolTip>
                    <TextBlock Text="👤"/>
                </Button>

                <Button x:Name="BtnAuthorSide"
                        Width="52" Height="52" Margin="0,3"
                        FontSize="22" Foreground="#CDD6F4"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Click="BtnAuthor_Click"
                        Visibility="Collapsed"
                        ToolTipService.InitialShowDelay="600">
                    <Button.ToolTip>
                        <ToolTip Content="Страница автора"/>
                    </Button.ToolTip>
                    <TextBlock Text="✍️"/>
                </Button>

                <Button x:Name="BtnAdminSide"
                        Width="52" Height="52" Margin="0,3"
                        FontSize="22" Foreground="#CDD6F4"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Click="BtnAdmin_Click"
                        Visibility="Collapsed"
                        ToolTipService.InitialShowDelay="600">
                    <Button.ToolTip>
                        <ToolTip Content="Администрирование"/>
                    </Button.ToolTip>
                    <TextBlock Text="⚙️"/>
                </Button>

                <Button x:Name="BtnFrozenWarn"
                        Width="52" Height="52" Margin="0,3"
                        FontSize="22" Foreground="#F38BA8"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Click="BtnProfile_Click"
                        Visibility="Collapsed"
                        ToolTipService.InitialShowDelay="600">
                    <Button.ToolTip>
                        <ToolTip Content="⚠️ Аккаунт заморожен"/>
                    </Button.ToolTip>
                    <TextBlock Text="🔒"/>
                </Button>

                <Button Width="52" Height="52" Margin="0,24,0,0"
                        FontSize="22" Foreground="#CDD6F4"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Click="BtnLogout_Click"
                        ToolTipService.InitialShowDelay="600">
                    <Button.ToolTip>
                        <ToolTip Content="Выйти"/>
                    </Button.ToolTip>
                    <TextBlock Text="🚪"/>
                </Button>

            </StackPanel>
        </Border>

        <!-- КОНТЕНТ -->
        <Frame x:Name="MainFrame" Grid.Column="1" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>
