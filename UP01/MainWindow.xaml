<Window x:Class="UP01.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UP01"
        mc:Ignorable="d"
        Title="JokeAndKing" Height="600" Width="900">
    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <Border Grid.Column="0" Background="#2C3E50">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                <Button Height="52" Margin="10,3"
                        FontSize="16" Foreground="White" FontWeight="Bold"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Click="BtnCatalog_Click"
                        ToolTipService.InitialShowDelay="600">
                    <Button.ToolTip>
                        <ToolTip Content="Каталог книг"/>
                    </Button.ToolTip>
                    <TextBlock Text="Каталог книг"/>
                </Button>

                <Button Height="52" Margin="10,3"
                        FontSize="16" Foreground="White" FontWeight="Bold"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Click="BtnLists_Click"
                        ToolTipService.InitialShowDelay="600">
                    <Button.ToolTip>
                        <ToolTip Content="Списки книг"/>
                    </Button.ToolTip>
                    <TextBlock Text="Списки книг"/>
                </Button>

                <Button Height="52" Margin="10,3"
                        FontSize="16" Foreground="White" FontWeight="Bold"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Click="BtnProfile_Click"
                        ToolTipService.InitialShowDelay="600">
                    <Button.ToolTip>
                        <ToolTip Content="Профиль"/>
                    </Button.ToolTip>
                    <TextBlock Text="Профиль"/>
                </Button>

                <Button x:Name="BtnAuthorSide"
                        Height="52" Margin="10,3" FontWeight="Bold"
                        FontSize="16" Foreground="White"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Click="BtnAuthor_Click"
                        Visibility="Collapsed"
                        ToolTipService.InitialShowDelay="600">
                    <Button.ToolTip>
                        <ToolTip Content="Страница автора"/>
                    </Button.ToolTip>
                    <TextBlock Text="Страница автора"/>
                </Button>

                <Button x:Name="BtnAdminSide"
                        Height="52" Margin="10,3"
                        FontSize="16" Foreground="White" FontWeight="Bold"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Click="BtnAdmin_Click"
                        Visibility="Collapsed"
                        ToolTipService.InitialShowDelay="600">
                    <Button.ToolTip>
                        <ToolTip Content="Администрирование"/>
                    </Button.ToolTip>
                    <TextBlock Text="Администрирование"/>
                </Button>

                <Button Width="52" Height="52" Margin="10,24,10,0"
                        FontSize="16" Foreground="White" FontWeight="Bold"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Click="BtnLogout_Click"
                        ToolTipService.InitialShowDelay="600">
                    <Button.ToolTip>
                        <ToolTip Content="Выйти"/>
                    </Button.ToolTip>
                    <TextBlock Text="Выйти"/>
                </Button>

            </StackPanel>
        </Border>

        <Frame x:Name="MainFrame" Grid.Column="1" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>
