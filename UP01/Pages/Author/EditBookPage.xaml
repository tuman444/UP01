<Page x:Class="UP01.Pages.Author.EditBookPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP01.Pages.Author"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Редактирование книги">

    <Grid Background="#1E1E2E">
        <ScrollViewer>
            <StackPanel Margin="30" MinWidth="400" MaxWidth="720" HorizontalAlignment="Left">

                <Button Content="← Назад"
                    Background="Transparent" Foreground="#89B4FA"
                    BorderThickness="0" HorizontalAlignment="Left"
                    Cursor="Hand" Margin="0,0,0,12"
                    Click="BtnBack_Click"/>

                <TextBlock x:Name="TbPageTitle" Text="Добавить книгу"
                       Foreground="White" FontSize="22" FontWeight="Bold"
                       Margin="0,0,0,20"/>

                <TextBlock Text="Название"
                       Foreground="White" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="TbTitle"
                     Background="White" Foreground="Black"
                     BorderBrush="#45475A" BorderThickness="1"
                     Padding="10,7" CaretBrush="#CDD6F4" Margin="0,0,0,12"/>

                <TextBlock Text="Описание"
                       Foreground="White" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="TbDesc"
                     Background="White" Foreground="Black"
                     BorderBrush="#45475A" BorderThickness="1"
                     Padding="10,7" CaretBrush="#CDD6F4"
                     Height="80" AcceptsReturn="True" TextWrapping="Wrap"
                     Margin="0,0,0,12"/>

                <TextBlock Text="Текст книги"
                       Foreground="White" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="TbContent"
                     Background="White" Foreground="Black"
                     BorderBrush="#45475A" BorderThickness="1"
                     Padding="10,7" CaretBrush="#CDD6F4"
                     Height="140" AcceptsReturn="True" TextWrapping="Wrap"
                     Margin="0,0,0,12"/>

                <TextBlock Text="Жанры"
                       Foreground="White" FontSize="12" Margin="0,0,0,4"/>
                <Border Background="#313244" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                    <ItemsControl x:Name="IcGenres">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding GenreName}" 
                                          IsChecked="{Binding IsSelected}"
                                          Foreground="White" 
                                          Margin="4" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <TextBlock Text="Обложка"
                       Foreground="White" FontSize="12" Margin="0,0,0,4"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Content="Выбрать файл"
                        Background="#E67E22" Foreground="White"
                        BorderThickness="0" Padding="12,7" Cursor="Hand"
                        Click="BtnPickCover_Click"/>
                    <TextBlock x:Name="TbCoverName" Text="Не выбрано"
                           Foreground="White" VerticalAlignment="Center"
                           Margin="10,0"/>
                </StackPanel>

                <TextBlock x:Name="TbError"
                       Foreground="#F38BA8" Margin="0,0,0,8"
                       Visibility="Collapsed"/>

                <Button Content="💾 Сохранить"
                    Background="#E67E22" Foreground="White"
                    BorderThickness="0" Padding="0,10"
                    Cursor="Hand" FontWeight="Bold"
                    Click="BtnSave_Click"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
