<Page x:Class="UP01.Pages.Author.AuthorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP01.Pages.Author"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Страница автора">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="#2C3E50" CornerRadius="8"
        Padding="10" Margin="5,0">
            <StackPanel Grid.Row="0" Orientation="Horizontal" Background="Transparent">
                <TextBlock Text="Мои книги"
                       Foreground="White" FontSize="22" FontWeight="Bold"
                       VerticalAlignment="Center"/>
                <Button Content="+ Добавить книгу"
                    Background="#CBA6F7" Foreground="#1E1E2E"
                    BorderThickness="0" Padding="14,8" Margin="16,0"
                    Cursor="Hand" Click="BtnAddBook_Click"/>
            </StackPanel>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <WrapPanel x:Name="WpBooks"/>
        </ScrollViewer>

        <Border Background="#2C3E50" CornerRadius="8"
        Padding="10" Margin="5,0" Grid.Row="2">
            <TextBlock  Text="Замороженные книги"
                   Foreground="#F38BA8" FontSize="16" FontWeight="Bold"/>
        </Border>
        
        <ItemsControl Grid.Row="3" x:Name="IcFrozen">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="#2C3E50" CornerRadius="8" Padding="12" Margin="0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Title}"
                                       Foreground="#F38BA8" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Оспорить заморозку"
                                    Background="#F38BA8" Foreground="#1E1E2E"
                                    BorderThickness="0" Padding="10,5" Cursor="Hand"
                                    Tag="{Binding}" Click="BtnUnfreezeBook_Click"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Page>
