<Page x:Class="UP01.Pages.Profile.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP01.Pages.Profile"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Профиль">

    <Grid Background="#1E1E2E">
        <ScrollViewer>
            <StackPanel Margin="30">

                <TextBlock Text="Профиль"
                       Foreground="#CDD6F4" FontSize="22" FontWeight="Bold"
                       Margin="0,0,0,20"/>

                <Border Background="#313244" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Имя:" Grid.Row="0"
                               Foreground="#A6ADC8" Margin="0,4"/>
                        <TextBlock x:Name="TbName" Grid.Row="0" Grid.Column="1"
                               Foreground="#CDD6F4" Margin="0,4"/>

                        <TextBlock Text="Логин:" Grid.Row="1"
                               Foreground="#A6ADC8" Margin="0,4"/>
                        <TextBlock x:Name="TbLogin" Grid.Row="1" Grid.Column="1"
                               Foreground="#CDD6F4" Margin="0,4"/>

                        <TextBlock Text="E-mail:" Grid.Row="2"
                               Foreground="#A6ADC8" Margin="0,4"/>
                        <TextBlock x:Name="TbEmail" Grid.Row="2" Grid.Column="1"
                               Foreground="#CDD6F4" Margin="0,4"/>

                        <TextBlock Text="Роль:" Grid.Row="3"
                               Foreground="#A6ADC8" Margin="0,4"/>
                        <TextBlock x:Name="TbRole" Grid.Row="3" Grid.Column="1"
                               Foreground="#CBA6F7" FontWeight="Bold" Margin="0,4"/>
                    </Grid>
                </Border>

                <Border x:Name="FreezePanel" Background="#F38BA8" CornerRadius="10"
                    Padding="16" Margin="0,0,0,16" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="⚠️ Ваш аккаунт заморожен"
                               FontWeight="Bold" Foreground="#1E1E2E" FontSize="14"
                               Margin="0,0,0,8"/>
                        <TextBlock Text="Оспорить — укажите причину:"
                               Foreground="#1E1E2E" FontSize="12"/>
                        <TextBox x:Name="TbUnfreezeReason"
                             Background="#FFDAD7" Foreground="#1E1E2E"
                             BorderThickness="0" Padding="8" Height="60"
                             AcceptsReturn="True" TextWrapping="Wrap" Margin="0,4"/>
                        <Button Content="Отправить заявку"
                            Background="#1E1E2E" Foreground="#F38BA8"
                            BorderThickness="0" Padding="12,6" Cursor="Hand"
                            Click="BtnRequestUnfreeze_Click"/>
                    </StackPanel>
                </Border>

                <Button x:Name="BtnRequestAuthor"
                    Content="📝 Подать заявку на роль Автора"
                    Background="#89B4FA" Foreground="#1E1E2E"
                    BorderThickness="0" Padding="0,10" Margin="0,0,0,16"
                    Cursor="Hand" Visibility="Collapsed"
                    Click="BtnRequestAuthor_Click"/>

                <TextBlock x:Name="TbStatus"
                       Foreground="#A6E3A1" Margin="0,0,0,16"
                       Visibility="Collapsed"/>

                <!-- Мои отзывы -->
                <TextBlock Text="Мои отзывы"
                       Foreground="#CDD6F4" FontSize="16" FontWeight="Bold"
                       Margin="0,0,0,8"/>

                <ItemsControl x:Name="IcReviews">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#313244" CornerRadius="8"
                                Padding="12" Margin="0,4">
                                <StackPanel>
                                    <TextBlock Text="{Binding Book.Title}"
                                           Foreground="#CBA6F7" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Rating, StringFormat='★ {0}/10'}"
                                           Foreground="#F9E2AF" FontSize="12"/>
                                    <TextBlock Text="{Binding ReviewText}"
                                           Foreground="#CDD6F4" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
