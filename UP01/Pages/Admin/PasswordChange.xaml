<Page x:Class="UP01.Pages.Admin.PasswordChange"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP01.Pages.Admin"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Смена пароля">

    <Grid>
        <Border Background="#2C3E50" CornerRadius="12" 
                Width="350" Height="260" 
                VerticalAlignment="Center" HorizontalAlignment="Center"
                Padding="25">
            <StackPanel VerticalAlignment="Center">

                <TextBlock x:Name="TxtHeader" Text="Смена текущего пароля" 
                           Foreground="White" FontSize="16" FontWeight="Bold" 
                           HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <TextBlock Text="Новый пароль:" Foreground="#CDD6F4" Margin="0,0,0,6" FontSize="13"/>
                <PasswordBox x:Name="PbNewPassword"
                             FontWeight="Bold" FontSize="14"
                             Background="White" Foreground="Black" 
                             Padding="8" BorderThickness="0" 
                             Margin="0,0,0,20"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="Назад" 
                            Background="#45475A" Foreground="White" 
                            BorderThickness="0" Padding="0,10" Margin="0,0,5,0"
                            Cursor="Hand" FontWeight="Medium" 
                            Click="BtnBack_Click"/>

                    <Button Grid.Column="1" Content="Сохранить" 
                            Background="#E67E22" Foreground="White" 
                            BorderThickness="0" Padding="0,10" Margin="5,0,0,0"
                            Cursor="Hand" FontWeight="Medium" 
                            Click="BtnSave_Click" Height="36" VerticalAlignment="Bottom"/>
                </Grid>

            </StackPanel>
        </Border>
    </Grid>
</Page>
