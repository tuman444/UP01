<Page x:Class="UP01.Pages.Auth.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP01.Pages.Auth"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Регистрация">

    <Grid>
        <ScrollViewer Background="#2C3E50" VerticalScrollBarVisibility="Auto">
            <StackPanel Width="340" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,30">

                <TextBlock Text="Регистрация"
                       FontSize="24" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center" Margin="0,0,0,24"/>

                <TextBlock Text="Отображаемое имя"
                       Foreground="White" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="TbDisplayName"
                     Background="White" Foreground="#2C3E50"
                     BorderBrush="#45475A" BorderThickness="1"
                     Padding="10,7" FontSize="14" Margin="0,0,0,12"
                     CaretBrush="#CDD6F4"/>

                <TextBlock Text="Логин"
                       Foreground="White" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="TbLogin"
                     Background="White" Foreground="#2C3E50"
                     BorderBrush="#45475A" BorderThickness="1"
                     Padding="10,7" FontSize="14" Margin="0,0,0,12"
                     CaretBrush="#CDD6F4"/>

                <TextBlock Text="E-mail"
                       Foreground="White" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="TbEmail"
                     Background="White" Foreground="#CDD6F4"
                     BorderBrush="#45475A" BorderThickness="1"
                     Padding="10,7" FontSize="14" Margin="0,0,0,12"
                     CaretBrush="#CDD6F4"/>

                <TextBlock Text="Пароль"
                       Foreground="White" FontSize="12" Margin="0,0,0,4"/>
                <PasswordBox x:Name="PbPassword"
                         Background="White" Foreground="#2C3E50"
                         BorderBrush="#45475A" BorderThickness="1"
                         Padding="10,7" FontSize="14" Margin="0,0,0,8"/>

                <TextBlock x:Name="TbError"
                       Foreground="#F38BA8" TextWrapping="Wrap"
                       HorizontalAlignment="Center" Margin="0,0,0,8"
                       Visibility="Collapsed"/>

                <Button Content="Зарегистрироваться"
                    Background="#E67E22" Foreground="White"
                    FontWeight="Bold" FontSize="14"
                    Padding="0,10" BorderThickness="0" Cursor="Hand"
                    Click="BtnRegister_Click"/>

                <Button Content="Уже есть аккаунт? Войти"
                    Background="Transparent" Foreground="#89B4FA"
                    BorderThickness="0" Cursor="Hand" FontSize="12"
                    Margin="0,12,0,0" Click="BtnGoLogin_Click"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
