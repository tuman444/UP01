<Page x:Class="UP01.Pages.Lists.ListsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP01.Pages.Lists"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Списки книг">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#313244" CornerRadius="8" Grid.Row="0"
        Padding="10" Margin="10,3">
            <StackPanel Orientation="Horizontal">
                <Button Content="Читаю" Tag="Читаю" Click="Tab_Click"
                    Background="#E67E22" Foreground="White"
                    BorderThickness="0" Padding="16,8" Margin="0,0,6,0" Cursor="Hand"/>
                <Button Content="Прочитано" Tag="Прочитано" Click="Tab_Click"
                    Background="#E67E22" Foreground="White"
                    BorderThickness="0" Padding="16,8" Margin="0,0,6,0" Cursor="Hand"/>
                <Button Content="В планах" Tag="В планах" Click="Tab_Click"
                    Background="#E67E22" Foreground="White"
                    BorderThickness="0" Padding="16,8" Margin="0,0,6,0" Cursor="Hand"/>
                <Button Content="Заброшено" Tag="Заброшено" Click="Tab_Click"
                    Background="#E67E22" Foreground="White"
                    BorderThickness="0" Padding="16,8" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <Border Background="#313244" CornerRadius="8" Grid.Row="1" 
            Padding="10" Margin="10,3">
            <Grid >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TbSearch" Grid.Column="0"
                     Background="#313244" Foreground="#CDD6F4"
                     BorderBrush="#45475A" BorderThickness="1"
                     Padding="10,7" Margin="0,0,8,0"
                     CaretBrush="#CDD6F4"
                     TextChanged="TbSearch_TextChanged" Grid.ColumnSpan="2"/>
                <Button Grid.Column="1" Content="A–Я" Click="BtnSortName_Click"
                    Background="#313244" Foreground="#CDD6F4"
                    BorderThickness="0" Padding="14,8" Margin="605,0,6,0" Cursor="Hand" Grid.ColumnSpan="2"/>
                <Button Grid.Column="2" Content="★" Click="BtnSortRating_Click"
                    Background="#313244" Foreground="#F9E2AF"
                    BorderThickness="0" Padding="14,8" Cursor="Hand" Grid.ColumnSpan="2" Margin="55,0,0,0"/>
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <WrapPanel x:Name="WpBooks"/>
        </ScrollViewer>
    </Grid>
</Page>
